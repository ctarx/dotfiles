+// Match one `bar.outputs` pattern against a Quickshell screen: a connector
+// name ("DP-1"), or "desc:<text>" found in the screen's model + serial number.
+function screenMatches(screen, pattern) {
+  var p = String(pattern || "").trim()
+  if (!p || !screen) return false
+  if (p.indexOf("desc:") === 0) {
+    var desc = [screen.model, screen.serialNumber].filter(function(v) { return !!v }).join(" ")
+    return desc.indexOf(p.slice(5).trim()) !== -1
+  }
+  return String(screen.name || "") === p
+}
+
+// Screens that get a bar. No outputs means every screen; "!pattern" excludes
+// one. When the list matches nothing connected, fall back to the first screen
+// so the menu and tray never vanish (e.g. undocked from the listed monitor).
+function barScreens(screens, outputs) {
+  var all = []
+  var count = screens ? Number(screens.length) || 0 : 0
+  for (var i = 0; i < count; i++) if (screens[i]) all.push(screens[i])
+
+  var patterns = Array.isArray(outputs)
+    ? outputs.map(function(p) { return String(p || "").trim() }).filter(function(p) { return p !== "" })
+    : []
+  if (patterns.length === 0) return all
+
+  var include = patterns.filter(function(p) { return p[0] !== "!" })
+  var exclude = patterns.filter(function(p) { return p[0] === "!" }).map(function(p) { return p.slice(1) })
+  var picked = all.filter(function(screen) {
+    var included = include.length === 0 || include.some(function(p) { return screenMatches(screen, p) })
+    return included && !exclude.some(function(p) { return screenMatches(screen, p) })
+  })
+  return picked.length > 0 ? picked : all.slice(0, 1)
+}
+
 if (typeof module !== "undefined") {
